{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"EMDASH_SITE_URL": "https://blog.builtwai.com",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "605a57aa-13c9-464e-a9cb-fb6f0ca78dd0",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	"kv_namespaces": [
		{ "binding": "CACHE", "id": "de926f9bc18443ecad2630e57e6daa40" },
		{ "binding": "SESSION", "id": "222f4158926842369755a2286ea0b096" },
	],
	// Run registry plugins in isolated Dynamic Workers.
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
