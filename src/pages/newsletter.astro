---
import { getPluginSettings } from "emdash";
import Base from "../layouts/Base.astro";
let ready = false;
try {
	// Secrets stay on the server. Render only whether email setup is complete.
	const settings = await getPluginSettings("r_w7bflj54ux44d3j4");
	ready = typeof settings.apiKey === "string" && !!settings.apiKey.trim()
		&& typeof settings.from === "string" && !!settings.from.trim();
} catch { ready = false; }
// The form must reflect credential changes without HTML cache reuse.
Astro.response.headers.set("Cache-Control", "no-store");
---
<Base title={"Newsletter"}>
	<section class="contact-page">
		<h1>{"Newsletter"}</h1>
		{ready ? (
			<form id="newsletter-form" action="/_emdash/api/plugins/r_nqufahfpg3jo7lbq/subscribe" method="post"
				data-error={"Your signup could not be completed. Please try again later."}
				data-success={"Check your email and confirm your subscription."}
				data-confirmed={"You are already subscribed."}>
				<p>{"Receive new posts by email. Confirm your address to subscribe; every newsletter includes an unsubscribe link."}</p>
				<label for="newsletter-email">{"Email"}</label>
				<input id="newsletter-email" name="email" type="email" autocomplete="email" maxlength="254" required />
				<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="contact-honeypot" />
				<input type="hidden" name="source" value="newsletter-page" />
				<button type="submit">{"Subscribe"}</button>
				<p class="contact-status" role="status" aria-live="polite"></p>
			</form>
		) : <p>{"Newsletter signup will be available once email setup is complete."}</p>}
	</section>
</Base>
<script>
	const form = document.querySelector<HTMLFormElement>("#newsletter-form");
	if (form) {
		const button = form.querySelector<HTMLButtonElement>("button")!;
		const status = form.querySelector<HTMLElement>(".contact-status")!;
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!form.reportValidity() || button.disabled) return;
			button.disabled = true;
			status.textContent = "";
			try {
				const response = await fetch(form.action, {
					method: "POST", headers: { Accept: "application/json" }, body: new FormData(form),
				});
				const result = await response.json();
			if (!response.ok || typeof result !== "object" || result === null
				|| !("ok" in result) || result.ok !== true || !("status" in result)
				|| (result.status !== "already_confirmed" && (!("emailSent" in result) || result.emailSent !== true))) throw new Error("Signup failed");
				status.textContent = result.status === "already_confirmed" ? form.dataset.confirmed! : form.dataset.success!;
				form.reset();
			} catch { status.textContent = form.dataset.error!; }
			finally { button.disabled = false; }
		});
	}
</script>
